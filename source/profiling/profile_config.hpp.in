/**
 * @file profile_config.hpp
 * @brief Defines the profiler switch and level the build chose, for every profiling header.
 * @author Mustafa Garip
 * @see docs/design/SUSHITRACK_PROFILING/README.md
 */

#pragma once

/// @brief 1 when the build records through SushiProfiler, 0 when every macro compiles to nothing.
#define SUSHITRACK_ENABLE_PROFILER @SUSHITRACK_ENABLE_PROFILER_VALUE@

/// @brief The most detailed level compiled in: 1 stages and counters, 2 adds fine zones.
#define SUSHITRACK_PROFILE_LEVEL @SUSHITRACK_PROFILE_LEVEL@
